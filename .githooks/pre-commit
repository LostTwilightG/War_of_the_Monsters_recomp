#!/bin/sh
# Versioned pre-commit hook: refreshes the progress block of README.md and docs/progress.svg
# (tools/update_readme.py, reads config/status.csv) and stages them so they land in the same commit.
#
# Enable once per clone:   git config core.hooksPath .githooks
# Opt-in refresh of status.csv through WSL (~12 s):   WOTM_REFRESH=1 git commit ...
# Never blocks a commit: every failure is only a warning.

root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
cd "$root" || exit 0
[ -f tools/update_readme.py ] || exit 0

for py in python3 python py; do
    command -v "$py" >/dev/null 2>&1 || continue
    "$py" tools/update_readme.py && break
done

files="README.md docs/progress.svg"
[ "${WOTM_REFRESH:-}" = 1 ] && files="$files config/status.csv"
for f in $files; do
    [ -f "$f" ] && { git add -- "$f" 2>/dev/null || echo "pre-commit: could not stage $f" >&2; }
done
exit 0
